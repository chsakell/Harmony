{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Aspire.Hosting.Dcp": "Warning"
    }
  },
  "Harmony": {
    // SqlServer      -> SQL Server container (default)
    // PostgreSQL     -> PostgreSQL container
    // LocalSqlServer -> your own SQL Server (e.g. localhost\SQLEXPRESS), see ConnectionStrings below
    "DatabaseProvider": "SqlServer",
    // true -> also start Elasticsearch + Kibana and enable the Serilog Elasticsearch sink
    "EnableElasticsearch": false
  },
  // Only used when Harmony:DatabaseProvider is LocalSqlServer. Override them in user secrets if needed.
  "ConnectionStrings": {
    "harmony-local": "Server=localhost\\SQLEXPRESS;Database=Harmony;Integrated Security=True;TrustServerCertificate=True",
    "automations-jobs-local": "Server=localhost\\SQLEXPRESS;Database=Harmony.Automations.Jobs;Integrated Security=True;TrustServerCertificate=True",
    "notifications-jobs-local": "Server=localhost\\SQLEXPRESS;Database=Harmony.Notifications.Jobs;Integrated Security=True;TrustServerCertificate=True"
  }
}
