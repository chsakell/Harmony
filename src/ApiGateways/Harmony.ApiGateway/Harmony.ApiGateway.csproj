<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!--
      MMLib.SwaggerForOcelot -> Kros.Utils requires Microsoft.Data.SqlClient >= 7, while the data services pin 6.1.x
      (the line EF Core 10 is built against). The gateway never talks to SQL, so it alone moves to 7.x.
    -->
    <SqlClientVersion>7.1.2</SqlClientVersion>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Aspire\Harmony.ServiceDefaults\Harmony.ServiceDefaults.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
    <PackageReference Include="MMLib.SwaggerForOcelot" />
    <PackageReference Include="Ocelot" />
  </ItemGroup>

</Project>
