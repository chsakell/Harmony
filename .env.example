# docker compose settings for Harmony. Copy to .env (git-ignored) and change the values.
# Every variable has a development default in docker-compose.yml, so .env is optional.
#
# IMPORTANT: database passwords are written into the persistent volumes on first start.
# If you change them later, either change them inside the database too, or reset the data with `docker compose down -v`.

# Development HTTPS certificate (dotnet dev-certs https -ep <dir>/harmony.pfx -p <password>)
HARMONY_CERT_PASSWORD=HarmonyTeamsSecretKey
# HARMONY_CERT_DIR=C:/Users/<you>/.aspnet/https

# SQL Server (sa)
SQL_SA_PASSWORD=%HarmonyTeams100
SQL_HOST_PORT=1433

# PostgreSQL (docker-compose.postgres.yml)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=HarmonyPostgres100
POSTGRES_HOST_PORT=5432

# MongoDB root user
MONGO_USER=harmony
MONGO_PASSWORD=HarmonyMongo100
MONGO_HOST_PORT=27017

# RabbitMQ
RABBITMQ_USER=harmony
RABBITMQ_PASSWORD=HarmonyRabbit100
RABBITMQ_HOST_PORT=5672
RABBITMQ_MANAGEMENT_HOST_PORT=15672

# Redis (cache + SignalR backplane)
REDIS_PASSWORD=HarmonyRedis100
REDIS_HOST_PORT=6379
